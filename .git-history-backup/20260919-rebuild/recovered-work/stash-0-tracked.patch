index 0000000..6ecbfda
--- /dev/null
+++ b/applications/backend/app/queries/providers/safety/create.sql
@@ -0,0 +1,28 @@
+WITH inserted AS (
+    INSERT INTO "PROVIDER_SAFETY_REPORTS" (
+        provider_id,
+        category,
+        title,
+        description,
+        is_serious,
+        status,
+        escalated_to_platform,
+        escalated_at,
+        created_at,
+        updated_at
+    ) VALUES (
+        %(provider_id)s,
+        %(category)s,
+        %(title)s,
+        %(description)s,
+        %(is_serious)s,
+        'open',
+        %(escalated_to_platform)s,
+        CASE WHEN %(escalated_to_platform)s THEN now() ELSE NULL END,
+        now(),
+        now()
+    )
+    RETURNING id, provider_id, category, title, description, is_serious, status,
+              escalated_to_platform, escalated_at, created_at, updated_at
+)
+SELECT * FROM inserted;

+"""Provider safety & incident reporting router (PRV-41).
+
+Prefix: /providers/me/safety
+
+- POST   /                 create a safety/incident report
+- GET    /                 list provider's safety reports
+- GET    /{report_id}      get one report
+- POST   /{report_id}/escalate  escalate a serious incident to platform admins
+"""
+from __future__ import annotations
+
+from typing import Any
+
+from fastapi import APIRouter, Depends, Path, Query
+from pydantic import BaseModel, Field
+
+from app.api.deps.provider_auth import get_current_provider
+from app.domains.providers.services.provider_safety_service import (
+    ProviderSafetyService,
+)
+from app.startup.composition import get_composition
+
+router = APIRouter(prefix="/providers/me/safety", tags=["provider-safety"])
+
+
+def _service() -> ProviderSafetyService:
+    return get_composition().provider_safety_service()
+
+
+class SafetyReportCreateBody(BaseModel):
+    category: str = Field(..., min_length=1, max_length=40)
+    title: str | None = Field(None, max_length=200)
+    description: str | None = Field(None, max_length=2000)
+    is_serious: bool = Field(False)
+
+
+class SafetyReportQueryParams(BaseModel):
+    category: str | None = Field(None, max_length=40)
+    status: str | None = Field(None, max_length=20)
+    search: str | None = Field(None, max_length=200)
+    limit: int = Field(20, ge=1, le=100)
+    offset: int = Field(0, ge=0)
+
+
+@router.post("", status_code=201)
+async def create_report(
+    body: SafetyReportCreateBody,
+    provider: dict = Depends(get_current_provider),
+) -> dict[str, Any]:
+    return await _service().create_report(
+        provider_id=str(provider["provider_id"]),
+        category=body.category,
+        title=body.title,
+        description=body.description,
+        is_serious=body.is_serious,
+    )
+
+
+@router.get("")
+async def list_reports(
+    params: SafetyReportQueryParams = Query(),
+    provider: dict = Depends(get_current_provider),
+) -> dict[str, Any]:
+    return await _service().list_reports(
+        provider_id=str(provider["provider_id"]),
+        category=params.category,
+        status=params.status,
+        search=params.search,
+        limit=params.limit,
+        offset=params.offset,
+    )
+
+
+@router.get("/{report_id}")
+async def get_report(
+    report_id: str = Path(...),
+    provider: dict = Depends(get_current_provider),
+) -> dict[str, Any]:
+    return await _service().get_report(
+        provider_id=str(provider["provider_id"]),
+        report_id=report_id,
+    )
+
+
+@router.post("/{report_id}/escalate", status_code=200)
+async def escalate_report(
+    report_id: str = Path(...),
+    provider: dict = Depends(get_current_provider),
+) -> dict[str, Any]:
+    return await _service().escalate_report(
+        provider_id=str(provider["provider_id"]),
+        report_id=report_id,
+    )
+
diff --git a/applications/backend/app/domains/providers/services/provider_safety_service.py b/applications/backend/app/domains/providers/services/provider_safety_service.py

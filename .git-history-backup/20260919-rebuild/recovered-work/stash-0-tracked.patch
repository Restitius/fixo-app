diff --git a/applications/backend/app/adapters/persistence/provider_safety_sql_adapter.py b/applications/backend/app/adapters/persistence/provider_safety_sql_adapter.py
new file mode 100644
index 0000000..45129b8
--- /dev/null
+++ b/applications/backend/app/adapters/persistence/provider_safety_sql_adapter.py
@@ -0,0 +1,121 @@
+from __future__ import annotations
+
+from typing import Any
+
+from app.adapters.persistence.base import BaseRepositoryAdapter
+from app.ports.persistence.provider_safety_repository import (
+    ProviderSafetyRepositoryPort,
+)
+from app.queries.registry import query
+
+
+class ProviderSafetySqlAdapter(BaseRepositoryAdapter, ProviderSafetyRepositoryPort):
+    """PostgreSQL adapter for provider safety reports (PRV-41)."""
+
+    async def _row_to_report(self, row: dict[str, Any]) -> dict[str, Any]:
+        return {
+            'id': row.get('id'),
+            'provider_id': row.get('provider_id'),
+            'category': row.get('category'),
+            'title': row.get('title'),
+            'description': row.get('description'),
+            'is_serious': bool(row.get('is_serious', False)),
+            'status': row.get('status'),
+            'escalated_to_platform': bool(row.get('escalated_to_platform', False)),
+            'escalated_at': row.get('escalated_at'),
+            'created_at': row.get('created_at'),
+            'updated_at': row.get('updated_at'),
+        }
+
+    async def create_report(
+        self,
+        ctx: Any,
+        *,
+        provider_id: str,
+        category: str,
+        title: str | None,
+        description: str | None,
+        is_serious: bool,
+    ) -> dict:
+        sql = query('PROV.SAFETY.REPORTS.CREATE')
+        row = await self.db.fetch_one(
+            sql=sql,
+            params={
+                'provider_id': provider_id,
+                'category': category,
+                'title': title,
+                'description': description,
+                'is_serious': is_serious,
+                'escalated_to_platform': is_serious,
+            },
+        )
+        if row is None:
+            raise RuntimeError('Failed to create safety report')
+        return self._row_to_report(dict(row))
+
+    async def list_reports(
+        self,
+        ctx: Any,
+        *,
+        provider_id: str,
+        category: str | None = None,
+        status: str | None = None,
+        search: str | None = None,
+        limit: int = 20,
+        offset: int = 0,
+    ) -> list[dict]:
+        sql = query('PROV.SAFETY.REPORTS.LIST')
+        rows = await self.db.fetch_all(
+            sql=sql,
+            params={
+                'provider_id': provider_id,
+                'category': category,
+                'status': status,
+                'search': self._ilike(search) if search else None,
+                'limit': max(1, min(limit, 100)),
+                'offset': max(0, offset),
+            },
+        )
+        return [self._row_to_report(dict(row)) for row in rows]
+
+    async def get_report(
+        self,
+        ctx: Any,
+        *,
+        provider_id: str,
+        report_id: str,
+    ) -> dict | None:
+        sql = query('PROV.SAFETY.REPORTS.GET')
+        row = await self.db.fetch_one(
+            sql=sql,
+            params={
+                'provider_id': provider_id,
+                'id': report_id,
+            },
+        )
+        if row is None:
+            return None
+        return self._row_to_report(dict(row))
+
+    async def escalate_report(
+        self,
+        ctx: Any,
+        *,
+        provider_id: str,
+        report_id: str,
+    ) -> dict:
+        sql = query('PROV.SAFETY.REPORTS.ESCALATE')
+        row = await self.db.fetch_one(
+            sql=sql,
+            params={
+                'provider_id': provider_id,
+                'id': report_id,
+            },
+        )
+        if row is None:
+            raise RuntimeError('Failed to escalate safety report')
+        return self._row_to_report(dict(row))
+
+    @staticmethod
+    def _ilike(value: str) -> str:
+        return f'%{value}%'

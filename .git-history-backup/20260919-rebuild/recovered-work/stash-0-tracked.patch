@@ -0,0 +1,56 @@
+"""Provider safety & incident reporting (PRV-41).
+
+Serious incidents are escalated to platform administrators automatically
+when the report is created.
+"""
+
+from alembic import op
+
+UPGRADE_SQL = """
+CREATE TABLE IF NOT EXISTS "PROVIDER_SAFETY_REPORTS" (
+    "id" uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+    "provider_id" uuid NOT NULL REFERENCES "PROVIDERS"("id") ON DELETE CASCADE,
+    "category" text NOT NULL,
+    "title" text,
+    "description" text,
+    "is_serious" boolean NOT NULL DEFAULT false,
+    "status" text NOT NULL DEFAULT 'open',
+    "escalated_to_platform" boolean NOT NULL DEFAULT false,
+    "escalated_at" timestamptz,
+    "created_at" timestamptz NOT NULL DEFAULT now(),
+    "updated_at" timestamptz NOT NULL DEFAULT now(),
+    CONSTRAINT "chk_provider_safety_category" CHECK (
+        "category" IN (
+            'threatening_customer',
+            'unsafe_property',
+            'hazardous_environment',
+            'fraud',
+            'harassment',
+            'accident',
+            'injury',
+            'other'
+        )
+    ),
+    CONSTRAINT "chk_provider_safety_status" CHECK (
+        "status" IN ('open', 'under_review', 'closed')
+    )
+);
+
+CREATE INDEX IF NOT EXISTS "ix_provider_safety_provider_status_created"
+    ON "PROVIDER_SAFETY_REPORTS" ("provider_id", "status", "created_at" DESC);
+
+CREATE INDEX IF NOT EXISTS "ix_provider_safety_provider_created"
+    ON "PROVIDER_SAFETY_REPORTS" ("provider_id", "created_at" DESC);
+"""
+
+DOWNGRADE_SQL = """
+DROP TABLE IF EXISTS "PROVIDER_SAFETY_REPORTS" CASCADE;
+"""
+
+
+def upgrade() -> None:
+    op.execute(UPGRADE_SQL)
+
+
+def downgrade() -> None:
+    op.execute(DOWNGRADE_SQL)

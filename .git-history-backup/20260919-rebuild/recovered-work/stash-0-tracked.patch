index 0000000..e744971
--- /dev/null
+++ b/applications/backend/app/queries/providers/safety/list.sql
@@ -0,0 +1,29 @@
+SELECT
+    id,
+    provider_id,
+    category,
+    title,
+    description,
+    is_serious,
+    status,
+    escalated_to_platform,
+    escalated_at,
+    created_at,
+    updated_at
+FROM "PROVIDER_SAFETY_REPORTS"
+WHERE provider_id = %(provider_id)s
+  AND (
+      %(category)s::text IS NULL
+      OR category = %(category)s
+  )
+  AND (
+      %(status)s::text IS NULL
+      OR status = %(status)s
+  )
+  AND (
+      %(search)s IS NULL
+      OR title ILIKE %(search)s
+      OR description ILIKE %(search)s
+  )
+ORDER BY created_at DESC
+LIMIT %(limit)s OFFSET %(offset)s;

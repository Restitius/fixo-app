+UPDATE "PROVIDER_SAFETY_REPORTS"
+SET status = 'under_review',
+    escalated_to_platform = true,
+    escalated_at = now(),
+    updated_at = now()
+WHERE id = %(id)s
+  AND provider_id = %(provider_id)s
+  AND status = 'open'
+RETURNING id, provider_id, category, title, description, is_serious,
+          status, escalated_to_platform, escalated_at, created_at, updated_at;

+-- PROV.BOOKING.COMPLETE -- provider completes the service (Phase 21)
+UPDATE "BOOKINGS"
+   SET status           = 'COMPLETED',
+       completed_at     = now(),
+       updated_at       = now(),
+       current_latitude  = CASE WHEN :gps_lat IS NOT NULL THEN CAST(:gps_lat AS numeric) END,
+       current_longitude = CASE WHEN :gps_lng IS NOT NULL THEN CAST(:gps_lng AS numeric) END
+ WHERE booking_id = CAST(:booking_id AS uuid)
+   AND provider_id = CAST(:user_id AS uuid)
+   AND status      = 'IN_PROGRESS'
+RETURNING booking_id, status, completed_at, current_latitude, current_longitude, updated_at;

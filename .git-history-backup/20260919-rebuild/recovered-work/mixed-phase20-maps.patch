@@ -0,0 +1,41 @@
+"""Provider adapter registry — maps provider keys to concrete adapter classes."""
+from __future__ import annotations
+
+from typing import Any, Callable
+
+from app.integrations.adapters.base_adapter import ProviderAdapter
+
+ProviderFactory = Callable[[dict[str, Any]], ProviderAdapter]
+
+
+def default_provider_registry() -> dict[str, ProviderFactory]:
+    """Built-in registry of provider key -> adapter factory.
+
+    Factories receive a provider config dict from the integration definition
+    and credentials/settings and return a ready provider adapter.
+    """
+    return {
+        "nominatim": _nominatim_factory,
+    }
+
+
+def _nominatim_factory(config: dict[str, Any]) -> ProviderAdapter:
+    from app.integrations.clients.http_client import HttpClient
+    from app.integrations.clients.retry_client import RetryHttpClient
+    from app.integrations.providers.maps.nominatim_adapter import NominatimProviderAdapter
+
+    http = config.get("http_client")
+    if not isinstance(http, HttpClient) and http is not None:
+        http = None
+    if http is None:
+        http = RetryHttpClient(
+            base_url=config.get("base_url") or "https://nominatim.openstreetmap.org",
+            timeout_seconds=float(config.get("timeout_seconds", 10.0)),
+            default_headers={
+                "User-Agent": "FIXO-APP/1.0 (maps integration; contact: ops@fixo.local)",
+                "Accept": "application/json",
+            },
+        )
+    return NominatimProviderAdapter(
+        http, base_path=config.get("base_path", "search")
+    )

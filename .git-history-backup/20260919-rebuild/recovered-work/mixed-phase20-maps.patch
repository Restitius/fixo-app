+)
+from app.integrations.providers.maps.models import MapCandidate, MapResult, rank_closest
+
+logger = logging.getLogger(__name__)
+
+
+class NominatimHttpClient(HttpClient):
+    """Nominatim base transport with strong User-Agent and default headers."""
+
+    def __init__(
+        self,
+        *,
+        base_url: str = "https://nominatim.openstreetmap.org",
+        timeout_seconds: float = 10.0,

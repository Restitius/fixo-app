+"""Integration tests for the NominatimProviderAdapter (maps provider).
+
+Uses a FakeTransport that implements the HttpClient interface but returns
+canned responses, so no network access is required.
+"""
+from __future__ import annotations
+
+import json
+from typing import Any
+
+from app.integrations.clients.http_client import HttpClient, HttpResponse
+from app.integrations.providers.maps.nominatim_adapter import NominatimProviderAdapter
+
+
+REVERSE_BODY = json.dumps(
+    {
+        "display_name": "Noble House, 12 Main St, Dublin, D01, Ireland",
+        "lat": "53.3498",
+        "lon": "-6.2603",
+        "type": "house",
+        "importance": 0.8,
+        "osm_type": "node",
+        "osm_id": "123",
+        "address": {
+            "house_number": "12",
+            "road": "Main Street",
+            "city": "Dublin",
+            "county": "Dublin City",
+            "state": "Leinster",
+            "postcode": "D01",
+            "country": "Ireland",
+            "country_code": "ie",
+        },
+    }
+).encode("utf-8")
+
+GEOCODE_BODY = json.dumps(
+    [
+        {
+            "display_name": "Noble House, 12 Main St, Dublin, D01, Ireland",
+            "lat": "53.3498",
+            "lon": "-6.2603",
+            "type": "house",
+            "importance": 0.8,
+            "osm_type": "node",
+            "osm_id": "123",
+            "address": {
+                "house_number": "12",
+                "road": "Main Street",
+                "city": "Dublin",
+                "county": "Dublin City",
+                "state": "Leinster",
+                "postcode": "D01",
+                "country": "Ireland",
+                "country_code": "ie",
+            },
+        }
+    ]
+).encode("utf-8")
+
+
+class FakeTransport(HttpClient):
+    """Deterministic HttpClient stub returning canned Nominatim-style responses."""
+
+    def __init__(self, *, base_url: str = "https://nominatim.openstreetmap.org") -> None:
+        super().__init__(base_url=base_url, timeout_seconds=5.0, default_headers={})
+
+    async def request(
+        self, method: str, path: str, *, params: dict[str, Any] | None = None
+    ) -> HttpResponse:
+        if path == "reverse":
+            body = REVERSE_BODY
+        else:
+            body = GEOCODE_BODY
+        return HttpResponse(
+            status=200, headers={"content-type": "application/json"}, body=body
+        )
+
+
+def _make_adapter() -> NominatimProviderAdapter:
+    return NominatimProviderAdapter(FakeTransport(base_url="https://nominatim.openstreetmap.org"))
+
+
+async def test_geocode_returns_candidates() -> None:
+    adapter = _make_adapter()
+    result = await adapter.execute("geocode", {"address": "12 Main Street Dublin"})
+    assert result["ok"] is True
+    assert len(result["candidates"]) == 1
+    best = result["best"]
+    assert best is not None
+    assert best["display_name"].startswith("Noble House")
+    assert best["latitude"] == 53.3498
+    assert best["longitude"] == -6.2603
+    assert best["address"]["house_number"] == "12"
+    assert best["address"]["city"] == "Dublin"
+    assert best["address"]["country"] == "Ireland"
+    assert best["osm_type"] == "node"
+    assert best["osm_id"] == "123"
+
+
+async def test_reverse_returns_single_candidate() -> None:
+    adapter = _make_adapter()
+    result = await adapter.execute("reverse", {"lat": 53.3498, "lon": -6.2603})
+    assert result["ok"] is True
+    assert len(result["candidates"]) == 1
+    best = result["best"]
+    assert best is not None
+    assert best["latitude"] == 53.3498
+    assert best["longitude"] == -6.2603
+
+
+async def test_closest_ranks_by_distance() -> None:
+    adapter = _make_adapter()
+    result = await adapter.execute(
+        "closest",
+        {
+            "lat": 53.3498,
+            "lon": -6.2603,
+            "candidates": [
+                {"display_name": "Far", "lat": "53.0", "lon": "-6.0", "type": "place"},
+                {"display_name": "Near", "lat": "53.3498", "lon": "-6.2603", "type": "place"},
+                {"display_name": "Mid", "lat": "53.2", "lon": "-6.1", "type": "place"},
+            ],
+        },
+    )
+    assert result["ok"] is True
+    names = [c["display_name"] for c in result["candidates"]]
+    assert names == ["Near", "Mid", "Far"]
+
+
+async def test_empty_address_returns_empty_result() -> None:
+    adapter = _make_adapter()
+    result = await adapter.execute("geocode", {"address": ""})
+    assert result["ok"] is True
+    assert result["candidates"] == []

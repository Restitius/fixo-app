+        super().__init__(
+            base_url=base_url,
+            timeout_seconds=timeout_seconds,
+            default_headers={
+                "User-Agent": "FIXO-APP/1.0 (maps integration; contact: ops@fixo.local)",
+                "Accept": "application/json",
+            },
+        )
+
+
+class NominatimProviderAdapter(ProviderAdapter):
+    """Async Nominatim adapter backed by a shared HttpClient."""
+
+    provider_name = "nominatim"
+
+    def __init__(self, http_client: HttpClient, *, base_path: str = "search") -> None:
+        self._client = http_client
+        self._base_path = base_path.rstrip("/")
+
+    def transform_request(self, operation: str, payload: dict[str, Any]) -> dict[str, Any]:
+        return payload
+
+    def transform_response(self, operation: str, response: dict[str, Any]) -> dict[str, Any]:
+        return response
+
+    async def execute(self, operation: str, payload: dict[str, Any]) -> dict[str, Any]:
+        if operation == "geocode":
+            return await self._geocode(payload)
+        if operation == "reverse":
+            return await self._reverse(payload)
+        if operation == "closest":
+            return await self._closest(payload)
+        raise NotImplementedError(f"NominatimProviderAdapter does not support operation: {operation}")
+
+    async def _geocode(self, payload: dict[str, Any]) -> dict[str, Any]:
+        query = payload.get("address") or payload.get("q") or ""
+        if not query or not isinstance(query, str):
+            return MapResult.empty().to_dict()
+
+        params: dict[str, Any] = {
+            "q": query,
+            "format": "jsonv2",
+            "limit": int(payload.get("limit", 5)),
+            "addressdetails": 1,
+            "extratags": 1,
+        }
+        if "country" in payload and payload["country"]:
+            params["countrycodes"] = payload["country"]
+        if "bounded" in payload:
+            params["bounded"] = int(payload["bounded"])
+
+        response = await self._client.request("GET", self._base_path, params=params)
+        candidates = self._parse_geocode_list(response)
+        return MapResult.success(candidates).to_dict() if candidates else MapResult.empty().to_dict()
+
+    async def _reverse(self, payload: dict[str, Any]) -> dict[str, Any]:
+        lat = payload.get("lat")
+        lon = payload.get("lon")
+        try:
+            lat_f = float(lat)
+            lon_f = float(lon)
+        except (TypeError, ValueError):
+            return MapResult.failure("NOMINATIM.INVALID_COORDS", "lat and lon must be numbers").to_dict()
+
+        params: dict[str, Any] = {
+            "lat": lat_f,
+            "lon": lon_f,
+            "format": "jsonv2",
+            "addressdetails": 1,
+            "extratags": 1,
+            "zoom": int(payload.get("zoom", 18)),
+        }
+        response = await self._client.request("GET", "reverse", params=params)
+        candidate = self._parse_reverse(response)
+        if not candidate:
+            return MapResult.empty().to_dict()
+        return MapResult.success([candidate]).to_dict()
+
+    async def _closest(self, payload: dict[str, Any]) -> dict[str, Any]:
+        lat = payload.get("lat")
+        lon = payload.get("lon")
+    def _parse_geocode_list(self, response: HttpResponse) -> list[MapCandidate]:
+        body = response.json()
+        if body is None:
+            return []
+        items = body if isinstance(body, list) else []
+        candidates: list[MapCandidate] = []
+        for item in items:
+            candidate = self._candidate_from_item(item)
+            if candidate is not None:
+                candidates.append(candidate)
+        return candidates
+
+    def _parse_reverse(self, response: HttpResponse) -> MapCandidate | None:
+        body = response.json()
+        if not isinstance(body, dict):
+            return None
+        if "display_name" in body and ("lat" in body or "lon" in body):
+            return self._candidate_from_dict(body, display_name=body.get("display_name", ""))
+        return self._candidate_from_item(body) or self._candidate_from_dict(
+            body, display_name=body.get("display_name", "")
+        )
+
+    def _candidate_from_item(self, item: Any) -> MapCandidate | None:
+        if not isinstance(item, dict):
+            return None
+        lat = item.get("lat")
+        lon = item.get("lon")
+        try:
+            lat_f = float(lat)
+            lon_f = float(lon)
+        except (TypeError, ValueError):
+            return None
+        return self._candidate_from_dict(item, latitude=lat_f, longitude=lon_f)
+
+    def _candidate_from_dict(
+        self,
+        item: dict[str, Any],
+        *,
+        latitude: float | None = None,
+        longitude: float | None = None,
+        display_name: str | None = None,
+    ) -> MapCandidate | None:
+        lat = latitude if latitude is not None else self._float(item.get("lat"))
+        lon = longitude if longitude is not None else self._float(item.get("lon"))
+        if lat is None or lon is None:
+            return None
+        return MapCandidate(
+            display_name=display_name or str(item.get("display_name", "")),
+            latitude=lat,
+            longitude=lon,
+            osm_type=str(item.get("osm_type", "") or ""),
+            osm_id=str(item.get("osm_id", "") or ""),
+            type=str(item.get("type", "") or ""),
+            confidence=float(item.get("importance", 0.0) or 0.0),
+            address=self._structured_address(item),
+        )
+
+    def _structured_address(self, item: dict[str, Any]) -> dict[str, Any]:
+        address = item.get("address") or {}
+        result: dict[str, Any] = {}
+        for key in (
+            "house_number",
+            "road",
+            "neighbourhood",
+            "suburb",
+            "village",
+            "hamlet",
+            "town",
+            "city",
+            "county",
+            "state",
+            "postcode",
+            "country",
+            "country_code",
+        ):
+            value = address.get(key)
+            if value:
+                result[key] = value
+        return result
+
+    @staticmethod
+    def _float(value: Any) -> float | None:
+        try:
+            return float(value)
+        except (TypeError, ValueError):
+            return None
+
+    async def _closest(self, payload: dict[str, Any]) -> dict[str, Any]:
+        lat = payload.get("lat")
+        lon = payload.get("lon")
+        try:
+            lat_f = float(lat)
+            lon_f = float(lon)
+        except (TypeError, ValueError):
+            return MapResult.failure("NOMINATIM.INVALID_COORDS", "lat and lon must be numbers").to_dict()
+
+        candidates = []
+        for item in payload.get("candidates", []) or []:
+            candidate = self._candidate_from_item(item)
+            if candidate is not None:
+                candidates.append(candidate)
+
+        if not candidates:
+            return MapResult.failure("NOMINATIM.NO_CANDIDATES", "no candidates to rank").to_dict()
+
+        ranked = rank_closest(candidates, lat_f, lon_f)
+        return MapResult.success(ranked).to_dict()

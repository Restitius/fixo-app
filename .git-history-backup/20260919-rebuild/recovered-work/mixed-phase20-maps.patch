@@ -0,0 +1,100 @@
+"""Integration test: AddressService auto-geocodes addresses via MapsGateway."""
+from __future__ import annotations
+
+import pytest
+
+from app.domains.locations.services.address_service import AddressService
+
+
+class FakeAddresses:
+    """Minimal AddressRepository double for AddressService."""
+    def __init__(self):
+        self.created = None
+        self._existing = []
+
+    async def list(self, customer_id):
+        return self._existing
+
+    async def get(self, customer_id, address_id):
+        return None  # not used in create flow
+
+    async def create(self, customer_id, params):
+        self.created = dict(params)
+        return self.created
+
+    async def update(self, customer_id, address_id, params):
+        return {}
+
+    async def delete(self, customer_id, address_id):
+        return True
+
+    async def set_default(self, customer_id, address_id):
+        return True
+
+
+class FakeMaps:
+    """MapsGateway double that returns a single candidate."""
+    async def geocode(self, address):
+        return {
+            "ok": True,
+            "candidates": [
+                {
+                    "display_name": "123 Fake St, Dublin, Ireland",
+                    "latitude": 53.3498,
+                    "longitude": -6.2603,
+                }
+            ],
+            "best": {
+                "display_name": "123 Fake St, Dublin, Ireland",
+                "latitude": 53.3498,
+                "longitude": -6.2603,
+            },
+        }
+
+    async def reverse(self, latitude, longitude):
+        return {"ok": True, "candidates": [], "best": None}
+
+    async def closest(self, latitude, longitude, candidates):
+        return {"ok": True, "candidates": candidates, "best": candidates[0]}
+
+    async def route(self, origin, destination):
+        return {"ok": True, "candidates": [], "best": None}
+
+
+@pytest.fixture
+def service():
+    addresses = FakeAddresses()
+    maps = FakeMaps()
+    return AddressService(addresses=addresses, maps=maps), addresses
+
+
+async def test_create_auto_geocodes_address(service):
+    svc, addresses = service
+    data = {
+        "label": "Home",
+        "recipient_name": "Alice",
+        "phone": "+35312345678",
+        "street_address": "123 Fake St",
+        "city": "Dublin",
+        "country": "Ireland",
+    }
+    row = await svc.create("cust-1", data)
+    assert addresses.created["latitude"] == 53.3498
+    assert addresses.created["longitude"] == -6.2603
+
+
+async def test_create_skips_geocode_when_coords_provided(service):
+    svc, addresses = service
+    data = {
+        "label": "Home",
+        "recipient_name": "Alice",
+        "phone": "+35312345678",
+        "street_address": "123 Fake St",
+        "city": "Dublin",
+        "country": "Ireland",
+        "latitude": 50.0,
+        "longitude": -7.0,
+    }
+    row = await svc.create("cust-1", data)
+    assert addresses.created["latitude"] == 50.0
+    assert addresses.created["longitude"] == -7.0

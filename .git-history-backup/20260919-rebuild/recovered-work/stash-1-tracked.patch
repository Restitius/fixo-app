diff --git a/applications/backend/app/domains/providers/services/provider_safety_service.py b/applications/backend/app/domains/providers/services/provider_safety_service.py
new file mode 100644
index 0000000..e4d9f06
--- /dev/null
+++ b/applications/backend/app/domains/providers/services/provider_safety_service.py
@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+from typing import Any
+
+from app.shared.exceptions.hierarchy import ValidationError, NotFoundError
+from app.domains.providers.services.base_provider_service import BaseProviderService
+from app.ports.persistence.provider_safety_repository import (
+    ProviderSafetyRepositoryPort,
+)
+
+
+class ProviderSafetyService(BaseProviderService):
+    """Provider safety & incident reporting service (PRV-41).
+
+    Serious incidents can be escalated to platform administrators.
+    """
+
+    def __init__(self, *, safety: ProviderSafetyRepositoryPort, **kwargs: Any) -> None:
+        super().__init__(**kwargs)
+        self._safety = safety
+
+    @property
+    def safety(self) -> ProviderSafetyRepositoryPort:
+        return self._safety
+
+    ALLOWED_CATEGORIES = {
+        "threatening_customer",
+        "unsafe_property",
+        "hazardous_environment",
+        "fraud",
+        "harassment",
+        "accident",
+        "injury",
+        "other",
+    }
+
+    ALLOWED_STATUSES = {"open", "under_review", "closed"}
+
+    async def create_report(
+        self,
+        *,
+        provider_id: str,
+        category: str,
+        title: str | None = None,
+        description: str | None = None,
+        is_serious: bool = False,
+    ) -> dict[str, Any]:
+        if category not in self.ALLOWED_CATEGORIES:
+            raise ValidationError(f"Invalid safety category: {category}")
+
+        return await self.safety.create_report(
+            provider_id=provider_id,
+            category=category,
+            title=title or None,
+            description=description or None,
+            is_serious=is_serious,
+        )
+
+    async def list_reports(
+        self,
+        *,
+        provider_id: str,
+        category: str | None = None,
+        status: str | None = None,
+        search: str | None = None,
+        limit: int = 20,
+        offset: int = 0,
+    ) -> dict[str, Any]:
+        if category is not None and category not in self.ALLOWED_CATEGORIES:
+            raise ValidationError(f"Invalid safety category: {category}")
+
+        if status is not None and status not in self.ALLOWED_STATUSES:
+            raise ValidationError(f"Invalid status filter: {status}")
+
+        rows = await self.safety.list_reports(
+            provider_id=provider_id,
+            category=category,
+            status=status,
+            search=search,
+            limit=limit,
+            offset=offset,
+        )
+
+        return {
+            "items": rows,
+            "limit": limit,
+            "offset": offset,
+        }
+
+    async def get_report(
+        self,
+        *,
+        provider_id: str,
+        report_id: str,
+    ) -> dict[str, Any]:
+        row = await self.safety.get_report(
+            provider_id=provider_id,
+            report_id=report_id,
+        )
+        if row is None:
+            raise NotFoundError("Safety report not found")
+        return row
+
+    async def escalate_report(
+        self,
+        *,
+        provider_id: str,
+        report_id: str,
+    ) -> dict[str, Any]:
+        return await self.safety.escalate_report(
+            provider_id=provider_id,
+            report_id=report_id,
+        )
+

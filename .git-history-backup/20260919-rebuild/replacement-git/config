[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
	autocrlf = false
[user]
	name = Restitius Rushambya
	email = restitius.rushambya@gmail.com
[remote "origin"]
	url = https://github.com/Restitius/fixo-app.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "staging"]
	remote = origin
	merge = refs/heads/staging
[branch "dev"]
	remote = origin
	merge = refs/heads/dev
[branch "feature/recovered-work"]
	remote = origin
	merge = refs/heads/feature/recovered-work

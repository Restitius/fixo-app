# =============================================================================
# FIXO-APP environment template — copy to .env and adjust per environment.
# NEVER commit the real .env (see .gitignore).
# =============================================================================

# --- Identity -----------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# --- Logical databases (architecture sections 14-15) --------------------------
# PRIMARY_DB is required; others activate when non-empty.
PRIMARY_DB_URL=postgresql+asyncpg://fixo:fixo@localhost:5432/fixo
ANALYTICS_DB_URL=
AUDIT_DB_URL=
REPORTING_DB_URL=
LEGACY_ORACLE_DSN=

# --- Infrastructure services ----------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=
KAFKA_BROKERS=

# --- Security -------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600
FIELD_ENCRYPTION_KEY=

# --- Paths ------------------------------------------------------------------------
STORAGE_DIR=./storage
LOG_DIR=./storage/logs

# --- HTTP ---------------------------------------------------------------------------
CORS_ORIGINS=*

# --- Integration credentials (referenced by registries/integrations) -----------------
PAYMENT_PRIMARY_API_KEY=
PAYMENT_PRIMARY_API_SECRET=
EMAIL_PRIMARY_HOST=
EMAIL_PRIMARY_USER=
EMAIL_PRIMARY_PASSWORD=
SMS_PRIMARY_API_KEY=
SMS_PRIMARY_SENDER_ID=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
SEARCH_ES_API_KEY=

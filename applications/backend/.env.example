# =============================================================================
# FIXO-APP environment template — copy to .env and adjust per environment.
# NEVER commit the real .env (see .gitignore).
# =============================================================================

# Identity 
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# Logical databases (architecture sections 14-15) 
# PRIMARY_DB is required; others activate when non-empty.
PRIMARY_DB_URL=postgresql+asyncpg://fixo:fixo@localhost:5432/fixo
ANALYTICS_DB_URL=
AUDIT_DB_URL=
REPORTING_DB_URL=
LEGACY_ORACLE_DSN=

# Infrastructure services 
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=
KAFKA_BROKERS=

#  Security 
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600
FIELD_ENCRYPTION_KEY=

# Paths 
STORAGE_DIR=./storage
LOG_DIR=./storage/logs

# HTTP 
CORS_ORIGINS=*

#  Integration credentials (referenced by registries/integrations) 
PAYMENT_PRIMARY_API_KEY=
PAYMENT_PRIMARY_API_SECRET=
EMAIL_PRIMARY_HOST=
EMAIL_PRIMARY_USER=
EMAIL_PRIMARY_PASSWORD=
EMAIL_PRIMARY_PORT=587
EMAIL_PRIMARY_FROM=
SMS_PRIMARY_API_KEY=
SMS_PRIMARY_SENDER_ID=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
SEARCH_ES_API_KEY=


# SWALA SMS
SWALA_SMS_ENABLED=false
SWALA_SMS_BASE_URL=https://swalasms.com/api/v1
SWALA_SMS_API_KEY=
SWALA_SMS_SENDER_ID=FIXO APP
SWALA_SMS_WEBHOOK_SECRET=
SWALA_SMS_TIMEOUT_SECONDS=10
SWALA_SMS_MAX_RETRIES=2
SWALA_SMS_MODE=sandbox

# EMAIL — INT.EMAIL.TRANSACTIONAL.V1 ships disabled (register_integrations.py)
# until real SMTP credentials above are supplied; then flip enabled=True the
# same way SWALA_SMS_ENABLED was flipped once its credentials were live.
